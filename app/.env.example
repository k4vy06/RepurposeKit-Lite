# ── AI Provider ─────────────────────────────────────────────────────────────
# Set to "openai" and provide a key to enable real AI generation.
# Leave as "mock" to run in demo mode (no external calls).
AI_PROVIDER=mock
OPENAI_API_KEY=

# Optional: override the model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# ── Security ─────────────────────────────────────────────────────────────────
# Generate a strong random secret for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-deploying

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite default — change to a proper DB URL for production
DATABASE_URL=sqlite:///./repurposekit.db
